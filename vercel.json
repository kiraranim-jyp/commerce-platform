{
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @commerce/admin build",
  "installCommand": "pnpm install",
  "outputDirectory": ".next",
  "functions": {
    "src/app/api/pipeline/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/daily-price-check/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-price-check",
      "schedule": "0 16 * * *"
    }
  ]
}
