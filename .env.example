# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma)
DATABASE_URL=
DIRECT_URL=

# OpenAI (선택, 유료 Provider)
OPENAI_API_KEY=

# Gemini (무료 1차 이미지 분류 Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Naver Commerce
NAVER_LOGIN_ID=
NAVER_LOGIN_PASSWORD=

# Browser Agent
BROWSER_HEADLESS=true
BROWSER_STORAGE_DIR=storage/sessions

# Crawler
CRAWLER_MIN_IMAGE_WIDTH=200
CRAWLER_MIN_IMAGE_HEIGHT=200
CRAWLER_NAV_TIMEOUT_MS=30000

# Image Pipeline
IMAGE_STORAGE_ROOT=storage
IMAGE_LOGS_ROOT=logs
IMAGE_STANDARD_WIDTH=1500
IMAGE_STANDARD_HEIGHT=2000
IMAGE_STANDARD_BACKGROUND=white
IMAGE_STANDARD_JPEG_QUALITY=95
IMAGE_UPSCALE_THRESHOLD_WIDTH=1500
IMAGE_UPSCALE_THRESHOLD_HEIGHT=2000
IMAGE_REMOVE_BACKGROUND_FOR=PRODUCT
OPENAI_VISION_MODEL=gpt-4o-mini
MARKETPLACE=NAVER

# Coupang (Wing Open API) — 절대 프론트엔드/localStorage/상품 데이터/Git에 값을
# 넣지 않는다. apps/admin/src/app/api/coupang/** 서버 라우트에서만 읽는다.
# 이제 아래 값들은 /settings 페이지에서 저장하는 게 기본 경로다(Supabase
# coupang_seller_settings 테이블) — 여기 env var는 Supabase에 값이 없을 때만
# 쓰이는 로컬 개발용 폴백이다.
# 인증 정보(access/secret key는 쿠팡 Wing > 오픈API 관리에서 발급)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=
# 쿠팡 Wing 로그인(대시보드) 계정 ID — access/secret key와는 다른 값
COUPANG_VENDOR_USER_ID=
# 아래는 쿠팡 Wing에 미리 등록해둔 판매자 계정 설정값이다(비밀번호류가 아니라
# 배송/반품 운영 정보) — 값이 없으면 실제 등록 시도가 VALIDATION_ERROR로 막힌다.
COUPANG_DELIVERY_COMPANY_CODE=
COUPANG_RETURN_CENTER_CODE=
COUPANG_RETURN_CHARGE_NAME=
COUPANG_COMPANY_CONTACT_NUMBER=
COUPANG_RETURN_ZIP_CODE=
COUPANG_RETURN_ADDRESS=
COUPANG_RETURN_ADDRESS_DETAIL=
COUPANG_OUTBOUND_SHIPPING_PLACE_CODE=
# 있으면 쿠팡 API 요청만 이 프록시(Fixie 등)를 경유한다 — 없으면(로컬 개발 등)
# 지금처럼 직접 연결한다. 다른 외부 API(Naver, Supabase 등)에는 영향 없다.
FIXIE_URL=

# 네이버 쇼핑 검색(오픈API) — SmartStore 등록용 SMARTSTORE_CLIENT_ID/SECRET과는
# 별개의 네이버 개발자센터 애플리케이션이 필요하다(재사용 불가). 미설정 시
# 국내 가격비교는 NOT_CONFIGURED로 표시되고 해외 원가 관측만 계속 저장된다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 11번가/G마켓·옥션(ESM) — 아직 SOON 상태(실제 등록 API 미구현, register()는
# credential 유무와 무관하게 항상 NOT_IMPLEMENTED). 값을 넣어도 실제 API를
# 호출하지 않는다 — 공식 문서 확보 전까지는 인프라만 준비해둔 상태다.
ELEVENST_API_KEY=
ELEVENST_API_SECRET=
ESM_API_KEY=
ESM_API_SECRET=

# Vercel Cron(daily-price-check) 인증 — 설정하지 않으면 인증을 건너뛰고
# 통과시킨다(Vercel Cron이 프로젝트 내부에서만 트리거되므로 미설정을 이유로
# 스케줄러 전체를 죽이지 않는다). 값을 넣으면 그 순간부터 Authorization
# 헤더를 실제로 검증한다.
CRON_SECRET=
