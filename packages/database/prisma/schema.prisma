generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// P0-CHANNEL-03 PHASE E(CPO 확정 ㉮, 2026-09-25) — **따져의 상품 정체성.**
///
/// 지금까지 정체성이 없었고 `snapshot_id` 하나로 외부 상품에 연결했다. snapshot 은
/// 「수집·분석 1회」라 URL 을 다시 분석하면 새로 생기고, 그때 이전 등록과의 연결이
/// 끊어진다. 그 결과 한 상품이 SmartStore 외부번호 6개로 갈라진 일이 실제로 있다.
///
/// 🔴 `sourceUrl` 은 «식별자가 아니다». @unique 를 제거한 이유:
///   · 같은 상품이 URL 을 바꿀 수 있다  · 같은 URL 에서 상품이 바뀔 수 있다
///   · locale/campaign 변형이 있다
/// 「동일성 판단 후보 정보」로만 남기고, 🔴 URL 로 자동 merge 하지 않는다.
model Product {
  id        String   @id @default(cuid())
  // 🔴 컬럼은 camelCase 다(sourceUrl · createdAt · updatedAt). 표 이름만
  // snake_case 로 바꿨고 컬럼은 건드리지 않았다 — @map 을 붙이면 없는 컬럼을
  // 가리키게 된다(한 번 잘못 붙였다가 실측으로 확인하고 되돌렸다).
  sourceUrl String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔴 066 — 소유자. 이 스키마의 다른 표와 «같은» 격리를 쓴다.
  workspaceId String?  @map("workspace_id") @db.Uuid

  /// ══ PIVOT-03-A (CPO 확정, 2026-10-05) — **셀러의 명시적 소싱 결정.** ═══════
  ///
  /// 🔴 파생이 «아니다». `Master Ready`(= Product ∧ 이 값 ∧ 기존 readiness)는
  /// 애플리케이션이 계산하지만, 「어디서 사올지」는 사람의 의사표시라 저장한다.
  ///
  /// 🔴 Product 에 두는 이유: snapshot workspace jsonb 에 넣으면 재분석 때
  /// 사라진다. snapshot 은 「수집·분석 1회」이고, 그 소실이 이 모델 머리 주석이
  /// 기록한 사고 구조다(외부번호 6개로 갈라진 일).
  ///
  /// 🔴 품절로는 비우지 «않는다» — 후보의 availability 를 OUT_OF_STOCK 으로 두고
  /// 선택은 유지한다. 자동으로 풀면 셀러가 «왜» 풀렸는지 알 수 없다.
  selectedSourcingCandidateId String?            @map("selected_sourcing_candidate_id") @db.Uuid
  selectedSourcingCandidate   SourcingCandidate? @relation("SelectedSource", fields: [selectedSourcingCandidateId], references: [id], onDelete: SetNull)

  channelProducts    ChannelProduct[]
  sourcingCandidates SourcingCandidate[] @relation("ProductCandidates")

  /// 🔴 065 — 실제 표 이름은 snake_case `products` 다. 이 스키마의 다른 표가
  /// 전부 그렇고, "Product" 만 대문자 단수로 혼자 달랐다(Prisma 초기 잔재).
  /// 행 0건일 때 바꿨다 — 행이 생긴 뒤에는 훨씬 무거워진다.
  @@map("products")
}

/// P0-CHANNEL-03 PHASE E — **«현재» 외부 채널 상품과의 연결.**
///
/// 🔴 `registration_attempts` 와 역할이 다르다:
///     ChannelProduct        지금 어느 외부 상품과 연결돼 있는가  (상태)
///     RegistrationAttempt   무엇을 시도했는가                   (이력)
/// 「마지막 attempt = 현재 상태」라는 가정이 위의 중복을 만들었다. 섞지 않는다.
///
/// 🔴 `@@unique([productId, channel])` 를 «아직» 걸지 않는다 — 기존 중복이
/// Product 에 연결되는 순간 제약 위반이 된다. 중복 정리(CEO 판단) 뒤 PHASE F 에서.
model ChannelProduct {
  id                String   @id @default(cuid())
  productId         String   @map("product_id")
  /// "smartstore" | "coupang" | "lotteon" — text 다. lotteon 은 PlatformId 에 없다.
  channel           String
  externalProductId String   @map("external_product_id")
  /// "LIVE" | "SUSPENDED" | "UNKNOWN". 🔴 기본값 UNKNOWN — 외부 상태를 조회하는
  /// 코드가 아직 없다. 모르는 것을 LIVE 라고 적지 않는다.
  status            String   @default("UNKNOWN")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, channel])
  @@index([channel, externalProductId])
  @@map("channel_products")
}

/// ══════════════════════════════════════════════════════════════════════════
/// PIVOT-03-A (CPO 확정, 2026-10-05) — **소싱 후보 = 「무엇을 어디서 얼마에 사오나」**
/// ══════════════════════════════════════════════════════════════════════════
///
/// 책임 경계(PIVOT-01/02 조사로 확정):
///   Product            persistent identity
///   ProductSnapshot    collection / analysis run
///   SourcingCandidate  sourcing evidence          ← 이 모델
///   Selected Source    seller's explicit decision ← Product.selected…Id
///   Master Ready       derived application state  (저장하지 않는다)
///   ChannelProduct     channel registration result
///
/// 🔴 **소유자는 Product 다.** snapshot 에 매달면 재분석 때 후보가 사라진다 —
/// snapshot 은 「수집·분석 1회」다. 「어느 수집에서 봤는가」는
/// `originatingSnapshotId` 로 따로 남긴다(provenance).
///
/// 🔴 **MI 결과가 여기 없다.** CASE A/B/C/D · 마진 · radar · 최종판정 칸이 없는
/// 것은 의도다. 그 값들은 가격·환율·배송비·수수료·판매가가 바뀌면 달라지는
/// **현재 시점의 계산**이고, 박아 두면 「22.4%」가 지금 판단인지 과거인지
/// 모호해진다. 감사용 이력이 필요해지면 `Decision History` 라는 «별도» 개념으로
/// 확장한다 — 이 모델에 그 책임을 억지로 넣지 않는다.
///
/// 🔴 **판매가가 아니다.** 국내 판매가는 `price_observations` 축이고, 둘을 한 칸에
/// 합치면 원가와 판매가가 섞인다.
///
/// 🔴 **어휘를 새로 만들지 않았다.** `availability` 는 shared 의 SourceStockState,
/// `identityMatchTruth` 는 030 이 domestic_product_links 에 쓴 목록 그대로다.
model SourcingCandidate {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id")
  product   Product @relation("ProductCandidates", fields: [productId], references: [id], onDelete: Cascade)

  /// 🔴 provenance. snapshot 이 지워져도 후보는 산다(소유자는 Product 다).
  /// NULL 허용 — 수집 밖에서 셀러가 직접 넣은 후보가 있을 수 있다.
  originatingSnapshotId String? @map("originating_snapshot_id") @db.Uuid

  /// 066 과 같은 격리.
  workspaceId String? @map("workspace_id") @db.Uuid

  /// ── 소싱처 정체성 ──────────────────────────────────────────────────────
  sourceUrl  String  @map("source_url")
  sourceSite String  @map("source_site")
  /// 🔴 추론하지 않는다 — 모르면 null 이다(「알 수 없음」과 「없음」을 섞지 않는다).
  sourceCountry String? @map("source_country")

  /// ── 원가 근거(관측값) ──────────────────────────────────────────────────
  priceAmount Decimal? @map("price_amount") @db.Decimal
  currency    String?

  /// 'IN_STOCK' | 'OUT_OF_STOCK' | 'INVALID' | 'UNKNOWN' — SourceStockState 그대로.
  availability String?

  /// 숫자를 지어내지 않는다 — 원문/메모를 그대로 남긴다.
  shippingNote String? @map("shipping_note")

  /// 030 의 MatchTruth 6값 그대로.
  identityMatchTruth String? @map("identity_match_truth")

  /// ══ 077 (PIVOT-03-B ③) — **출처 «사실».** ═══════════════════════════════
  /// 'DISCOVERED' | 'SELLER_ENTERED'. 🔴 NULL 은 legacy 미확정(UNKNOWN)이고
  /// 신규 정상 상태가 «아니다» — 기존 행을 backfill 하지 않았다.
  ///
  /// 🔴 `originatingSnapshotId` 와 «다른 일» 을 한다:
  ///     originatingSnapshotId  provenance 링크 — snapshot 삭제로 사라질 수 있다
  ///     sourceKind             출처 사실      — 사라지지 않는다
  /// 그래서 `DISCOVERED + snapshot NULL` 은 **정상** 이다(삭제된 뒤의 상태).
  ///
  /// 🔴 DB CHECK 는 한쪽만 지킨다: SELLER_ENTERED → snapshot 은 NULL.
  /// 「DISCOVERED 는 생성 시점에 snapshot 이 있어야 한다」는 생성 시점 조건이라
  /// CHECK 로 표현할 수 없고, **API 가 생성 시점에만** 검증한다.
  sourceKind String? @map("source_kind")

  /// 🔴 「언제 본 가격인가」. 없으면 후보가 낡았는지 말할 수 없다.
  observedAt DateTime? @map("observed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// 이 후보를 「선택한」 Product 들(역방향). 실제로는 0 또는 1 이다.
  selectedBy Product[] @relation("SelectedSource")

  /// 🔴 같은 Product 안에서 같은 소싱처 URL 이 두 번 서지 않는다. 가격이 바뀌면
  /// 행을 더하지 않고 그 행을 갱신한다 — 가격 «이력» 은 price_observations 의 일이다.
  @@unique([productId, sourceUrl])
  @@index([productId])
  @@index([workspaceId])
  @@index([originatingSnapshotId])
  @@map("sourcing_candidates")
}
