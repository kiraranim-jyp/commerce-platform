generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// P0-CHANNEL-03 PHASE E(CPO 확정 ㉮, 2026-09-25) — **따져의 상품 정체성.**
///
/// 지금까지 정체성이 없었고 `snapshot_id` 하나로 외부 상품에 연결했다. snapshot 은
/// 「수집·분석 1회」라 URL 을 다시 분석하면 새로 생기고, 그때 이전 등록과의 연결이
/// 끊어진다. 그 결과 한 상품이 SmartStore 외부번호 6개로 갈라진 일이 실제로 있다.
///
/// 🔴 `sourceUrl` 은 «식별자가 아니다». @unique 를 제거한 이유:
///   · 같은 상품이 URL 을 바꿀 수 있다  · 같은 URL 에서 상품이 바뀔 수 있다
///   · locale/campaign 변형이 있다
/// 「동일성 판단 후보 정보」로만 남기고, 🔴 URL 로 자동 merge 하지 않는다.
model Product {
  id        String   @id @default(cuid())
  // 🔴 컬럼은 camelCase 다(sourceUrl · createdAt · updatedAt). 표 이름만
  // snake_case 로 바꿨고 컬럼은 건드리지 않았다 — @map 을 붙이면 없는 컬럼을
  // 가리키게 된다(한 번 잘못 붙였다가 실측으로 확인하고 되돌렸다).
  sourceUrl String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channelProducts ChannelProduct[]

  /// 🔴 065 — 실제 표 이름은 snake_case `products` 다. 이 스키마의 다른 표가
  /// 전부 그렇고, "Product" 만 대문자 단수로 혼자 달랐다(Prisma 초기 잔재).
  /// 행 0건일 때 바꿨다 — 행이 생긴 뒤에는 훨씬 무거워진다.
  @@map("products")
}

/// P0-CHANNEL-03 PHASE E — **«현재» 외부 채널 상품과의 연결.**
///
/// 🔴 `registration_attempts` 와 역할이 다르다:
///     ChannelProduct        지금 어느 외부 상품과 연결돼 있는가  (상태)
///     RegistrationAttempt   무엇을 시도했는가                   (이력)
/// 「마지막 attempt = 현재 상태」라는 가정이 위의 중복을 만들었다. 섞지 않는다.
///
/// 🔴 `@@unique([productId, channel])` 를 «아직» 걸지 않는다 — 기존 중복이
/// Product 에 연결되는 순간 제약 위반이 된다. 중복 정리(CEO 판단) 뒤 PHASE F 에서.
model ChannelProduct {
  id                String   @id @default(cuid())
  productId         String   @map("product_id")
  /// "smartstore" | "coupang" | "lotteon" — text 다. lotteon 은 PlatformId 에 없다.
  channel           String
  externalProductId String   @map("external_product_id")
  /// "LIVE" | "SUSPENDED" | "UNKNOWN". 🔴 기본값 UNKNOWN — 외부 상태를 조회하는
  /// 코드가 아직 없다. 모르는 것을 LIVE 라고 적지 않는다.
  status            String   @default("UNKNOWN")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, channel])
  @@index([channel, externalProductId])
  @@map("channel_products")
}
